/dts-v1/;
/plugin/;

&{/} {
	compatible = "renesas,ironhide", "renesas,r8a78000", "renesas,r8a78000-uio";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Renesas Ironhide board based on r8a78000";

	audio_clk_a: audio_clk_a {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	audio_clk_b: audio_clk_b {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	audio_clk_c: audio_clk_c {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	dummy_clk: dummy_clk {
		compatible = "fixed-clock";
		clock-frequency = <0>;
		#clock-cells = <0>;
	};

	can_clk: can {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	canxl_clk: canxl_clk {
		compatible = "fixed-clock";
		clock-frequency = <160000000>;
		#clock-cells = <0>;
	};

	msiof_clk: msiof_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <133333333>;
	};

	ssi_dummy_clk: ssi_dummy_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
		clock-output-names = "ssi";
	};

	scu_dummy_clk: scu_dummy_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
		clock-output-names = "scu";
	};

	extal_clk: extal {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	extalr_clk: extalr {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	firmware {

		scmi {
			compatible = "arm,scmi";
			mbox-names = "tx","rx";
			mboxes = <&mailbox 0 &mailbox 1>;
			shmem = <&cpu_scp_lpri0 &cpu_scp_hpri0>;
			#address-cells = <1>;
			#size-cells = <0>;
			/* This is to ensure scmi clock ops is atomic */
			atomic-threshold-us = <0xffffffff>;

			scmi_devpd: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <1>;
			};

			scmi_sys: protocol@12 {
				reg = <0x12>;
			};

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};

			scmi_reset: protocol@16 {
				reg = <0x16>;
				#reset-cells = <1>;
			};

			scmi_vendor: protocol@80 {
				reg = <0x80>;
				#reset-cells = <1>;
			};

		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	/* In the early phase, there is no clock control support,
	 * so assume that the clocks are enabled by default.
	 * Therefore, dummy clocks are used.
	 */
	dummy_clk_sgasyncd4: dummy_clk_sgasyncd4 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <266660000>;
	};

	dummy_clk_wdt: dummy_clk_wdt {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32800>;
		clock-output-names = "watchdog";
	};

	dummy_clk_cmt: dummy_clk_cmt {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	dummy_clk_tmu0: dummy_clk_tmu0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <16666666>;
	};

	dummy_clk_tmu: dummy_clk_tmu {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <133333333>;
	};

	rsw3_clk: rsw3_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	dummy_clk_wcrc: dummy_clk_wcrc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	/* External SCIF clock - to be overridden by boards that provide it */
	scif_clk: scif {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	/* External PCIe clock - can be overridden by the board */
	pcie4_bus_clk: pcie4_bus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	pcie6_bus_clk: pcie6_bus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	dummy_clk_sgasyncd16: dummy_clk_sgasyncd16 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <66666666>;
	};

	dummy_clk_s0asyncd8: dummy_clk_s0asyncd8 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	dummy_tcki: dummy_tcki {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <240000>;
		clock-output-names = "rtcatcki";
	};

	soc {
		compatible = "simple-bus";
		interrupt-parent = <&qvm_vdev_gic>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		mfis: mfis@18800000 {
			compatible = "renesas,mfis";
			reg = <0x0 0x18800000 0x0 0x1000>,
			      <0x0 0x18801000 0x0 0x1000>,
			      <0x0 0x18802000 0x0 0x1000>,
			      <0x0 0x18803000 0x0 0x1000>,
			      <0x0 0x18804000 0x0 0x1000>,
			      <0x0 0x18805000 0x0 0x1000>,
			      <0x0 0x18806000 0x0 0x1000>,
			      <0x0 0x18807000 0x0 0x1000>,
			      <0x0 0x189e0900 0x0 0x4>;
			reg-names = "ch0", "ch1", "ch2", "ch3",
				    "ch4", "ch5", "ch6", "ch7",
				     "unlock_reg";
			interrupts = <0x00 101 0x04>,
				     <0x00 103 0x04>,
				     <0x00 105 0x04>,
				     <0x00 107 0x04>,
				     <0x00 109 0x04>,
				     <0x00 111 0x04>,
				     <0x00 113 0x04>,
				     <0x00 115 0x04>;
			interrupt-names = "ch0", "ch1", "ch2", "ch3",
					  "ch4", "ch5", "ch6", "ch7";
			renesas,mfis-channels = <1>;
			status = "okay";
		};

		mailbox: mfis_mbox@18842000 {
			compatible = "renesas,mfis-mbox";
			#mbox-cells = <0x01>;
			reg = <0x00 0x18842004 0x00 0x04 0x00 0x18842000 0x00 0x04>;
			// interrupts = <0x00 4362 0x04>;
			interrupts = <0x00 41 0x04>;
			status = "okay";
		};

		mfis_lock@189e0000 {
			compatible = "renesas,mfis-lock-r8a78000\0renesas,mfis-lock-gen5";
			reg = <0x00 0x189e0000 0x00 0x900 0x00 0x189e0900 0x00 0x04>;
			reg-names = "io_base\0unlock_reg";
			#hwlock-cells = <0x01>;
		};

		chipid@189e0044 {
			compatible = "renesas,prr";
			reg = <0x00 0x189e0044 0x00 0x04>;
		};

		pfc: pinctrl@c0400000 {
			compatible = "renesas,pfc-r8a78000";
			reg = <0x00 0xc1080000 0x00 0x104 0x00 0xc1080800 0x00 0x104 0x00 0xc1081000 0x00 0x104 0x00 0xc0800000 0x00 0x104 0x00 0xc0800800 0x00 0x104 0x00 0xc0400000 0x00 0x104 0x00 0xc0400800 0x00 0x104 0x00 0xc0401000 0x00 0x104 0x00 0xc0401800 0x00 0x104 0x00 0xc9b00000 0x00 0x104 0x00 0xc9b00800 0x00 0x104>;

			eth25g2_pins: eth25g2 {
				groups = "eth25g2_mdio\0eth25g2_link\0eth25g2_phyint";
				function = "eth25g2";
				drive-strength = <0x18>;
			};

			ethes0_pins: ethes0 {
				groups = "ethes0_match\0ethes0_capture\0ethes0_pps";
				function = "ethes0";
				drive-strength = <0x18>;
			};

			hscif0_pins: hscif0 {
				groups = "hscif0_data\0hscif0_ctrl";
				function = "hscif0";
			};

			i2c0_pins: i2c0 {
				groups = "i2c0";
				function = "i2c0";
			};

			i2c1_pins: i2c1 {
				groups = "i2c1";
				function = "i2c1";
			};

			i2c2_pins: i2c2 {
				groups = "i2c2";
				function = "i2c2";
			};

			i2c3_pins: i2c3 {
				groups = "i2c3";
				function = "i2c3";
			};

			i2c4_pins: i2c4 {
				groups = "i2c4";
				function = "i2c4";
			};

			i2c5_pins: i2c5 {
				groups = "i2c5";
				function = "i2c5";
			};

			i2c6_pins: i2c6 {
				groups = "i2c6";
				function = "i2c6";
			};

			i3c0_pins: i3c0 {
				groups = "i3c0";
				function = "i3c0";
			};

			i3c1_pins: i3c1 {
				groups = "i3c1";
				function = "i3c1";
			};

			i3c2_pins: i3c2 {
				groups = "i3c2";
				function = "i3c2";
			};

			rsw3_pins: rsw3 {
				groups = "rsw3_match\0rsw3_capture\0rsw3_pps";
				function = "rsw3";
				drive-strength = <0x18>;
			};

			pcie40_pins: pcie40 {
				groups = "pcie40_clkreq_n";
				function = "pcie4";
			};

			msiof0_pins: msiof0 {
				groups = "msiof0_clk\0msiof0_sync\0msiof0_txd\0msiof0_rxd\0msiof0_ss1\0msiof0_ss2";
				function = "msiof0";
			};

			msiof6_pins: msiof6 {
				groups = "msiof6_clk_a\0msiof6_txd_a\0msiof6_rxd_a\0msiof6_ss1_a\0msiof6_ss2_a";
				function = "msiof6";
			};

			usb30_pins: usb0 {

				mux {
					groups = "usb0_vbus\0usb0";
					function = "usb0";
				};

				ovc {
					pins = "GP_10_1";
					bias-pull-down;
				};

				pwen {
					pins = "GP_10_0";
					bias-pull-up;
				};

				vbus {
					pins = "GP_10_2";
					bias-pull-up;
				};
			};

			usb20_pins: usb1 {

				mux {
					groups = "usb1_vbus\0usb1";
					function = "usb1";
				};

				ovc {
					pins = "GP_10_4";
					bias-pull-down;
				};

				pwen {
					pins = "GP_10_3";
					bias-pull-up;
				};

				vbus {
					pins = "GP_10_5";
					bias-pull-up;
				};
			};

			usb31_pins: usb2 {

				mux {
					groups = "usb2_vbus\0usb2";
					function = "usb2";
				};

				ovc {
					pins = "GP_10_7";
					bias-pull-down;
				};

				pwen {
					pins = "GP_10_6";
					bias-pull-up;
				};

				vbus {
					pins = "GP_10_8";
					bias-pull-up;
				};
			};

			usb21_pins: usb3 {

				mux {
					groups = "usb3_vbus\0usb3";
					function = "usb3";
				};

				ovc {
					pins = "GP_10_10";
					bias-pull-down;
				};

				pwen {
					pins = "GP_10_9";
					bias-pull-up;
				};

				vbus {
					pins = "GP_10_11";
					bias-pull-up;
				};
			};

			rpc_pins: rpc {
				groups = "rpc_clk2\0rpc_ctrl\0rpc_data\0rpc_reset\0rpc_int";
				function = "rpc";
			};

			mmc0_pins: mmc0 {
				groups = "mmc0_data8\0mmc0_ctrl\0mmc0_ds";
				function = "mmc0";
				drive-strength = <0x18>;
			};

			canfd0_pins: canfd0 {
				groups = "canfd0_data";
				function = "canfd0";
			};

			canfd1_pins: canfd1 {
				groups = "canfd1_data";
				function = "canfd1";
			};

			canfd2_pins: canfd2 {
				groups = "canfd2_data";
				function = "canfd2";
			};

			canfd3_pins: canfd3 {
				groups = "canfd3_data";
				function = "canfd3";
			};

			canfd4_pins: canfd4 {
				groups = "canfd4_data";
				function = "canfd4";
			};

			canfd5_pins: canfd5 {
				groups = "canfd5_data";
				function = "canfd5";
			};

			canfd6_pins: canfd6 {
				groups = "canfd6_data";
				function = "canfd6";
			};

			canfd7_pins: canfd7 {
				groups = "canfd7_data";
				function = "canfd7";
			};

			canfd8_pins: canfd8 {
				groups = "canfd8_data";
				function = "canfd8";
			};

			canfd9_pins: canfd9 {
				groups = "canfd9_data";
				function = "canfd9";
			};

			canfd10_pins: canfd10 {
				groups = "canfd10_data";
				function = "canfd10";
			};

			canfd11_pins: canfd11 {
				groups = "canfd11_data";
				function = "canfd11";
			};

			canfd12_pins: canfd12 {
				groups = "canfd12_data_b";
				function = "canfd12";
			};

			canfd13_pins: canfd13 {
				groups = "canfd13_data_b";
				function = "canfd13";
			};

			canfd14_pins: canfd14 {
				groups = "canfd14_data_b";
				function = "canfd14";
			};

			canfd15_pins: canfd15 {
				groups = "canfd15_data_b";
				function = "canfd15";
			};

			sound_pins: sound {
				groups = "ssi5_ctrl\0ssi5_data";
				function = "ssi5";
			};

			sound_clk_pins: sound_clk {
				groups = "audio_clk_a_a\0audio0_clkout0";
				function = "audio_clk";
			};

			dp0_hotplug_pins: dp0_hotplug {
				groups = "dp0_hotplug";
				function = "dp0_hotplug";
			};

			dp1_hotplug_pins: dp1_hotplug {
				groups = "dp1_hotplug";
				function = "dp1_hotplug";
			};

			dp2_hotplug_pins: dp2_hotplug {
				groups = "dp2_hotplug";
				function = "dp2_hotplug";
			};
		};

		cmt0: timer@c64c0000 {
			compatible = "renesas,rcar-gen5-cmt0";
			reg = <0 0xc64c0000 0 0x1004>;
			interrupts = <0x00 4088 0x04>,
				     <0x00 4089 0x04>;
			clocks = <&scmi_clk 515>, <&dummy_clk_cmt>;
			clock-names = "fck", "dummy_clk";
			resets = <&scmi_reset 515>;
			status = "disabled";
		};

		cmt1: timer@c64d0000 {
			compatible = "renesas,rcar-gen5-cmt1";
			reg = <0 0xc64d0000 0 0x1004>;
			interrupts = <0x00 4090 0x04>,
				     <0x00 4091 0x04>,
				     <0x00 4092 0x04>,
				     <0x00 4093 0x04>,
				     <0x00 4094 0x04>,
				     <0x00 4095 0x04>,
				     <0x00 4096 0x04>,
				     <0x00 4097 0x04>;
			clocks = <&scmi_clk 516>, <&dummy_clk_cmt>;
			clock-names = "fck", "dummy_clk";
			resets = <&scmi_reset 516>;
			status = "disabled";
		};

		cmt2: timer@c64e0000 {
			compatible = "renesas,rcar-gen5-cmt1";
			reg = <0 0xc64e0000 0 0x1004>;
			interrupts = <0x00 4098 0x04>,
				     <0x00 4099 0x04>,
				     <0x00 4100 0x04>,
				     <0x00 4101 0x04>,
				     <0x00 4102 0x04>,
				     <0x00 4103 0x04>,
				     <0x00 4104 0x04>,
				     <0x00 4105 0x04>;
			clocks = <&scmi_clk 517>, <&dummy_clk_cmt>;
			clock-names = "fck", "dummy_clk";
			resets = <&scmi_reset 517>;
			status = "disabled";
		};

		cmt3: timer@c64e8000 {
			compatible = "renesas,rcar-gen5-cmt1";
			reg = <0 0xc64e8000 0 0x1004>;
			interrupts = <0x00 4106 0x04>,
				     <0x00 4107 0x04>,
				     <0x00 4108 0x04>,
				     <0x00 4109 0x04>,
				     <0x00 4110 0x04>,
				     <0x00 4111 0x04>,
				     <0x00 4112 0x04>,
				     <0x00 4113 0x04>;
			clocks = <&scmi_clk 518>, <&dummy_clk_cmt>;
			clock-names = "fck", "dummy_clk";
			resets = <&scmi_reset 518>;
			status = "disabled";
		};

		tmu0: timer@1c030000 {
			compatible = "renesas,tmu";
			reg = <0 0x1c030000 0 0x30>;
			renesas,clk-rate-channel0;
			interrupts = <0x00 4114 0x04>,
				     <0x00 4115 0x04>,
				     <0x00 4116 0x04>;
			clocks = <&scmi_clk 386>, <&dummy_clk_tmu0>;
			clock-names = "fck", "dummy_clk_tmu0";
			resets = <&scmi_reset 386>;
			status = "disabled";
		};

		tmu1: timer@c0680000 {
			compatible = "renesas,tmu";
			reg = <0 0xc0680000 0 0x30>;
			interrupts = <0x00 4117 0x04>,
				     <0x00 4118 0x04>,
				     <0x00 4119 0x04>,
				     <0x00 4120 0x04>;
			clocks = <&scmi_clk 245>, <&dummy_clk_tmu>;
			clock-names = "fck", "dummy_clk_tmu";
			resets = <&scmi_reset 245>;
			status = "disabled";
		};

		tmu2: timer@c0690000 {
			compatible = "renesas,tmu";
			reg = <0 0xc0690000 0 0x30>;
			interrupts = <0x00 4121 0x04>,
				     <0x00 4122 0x04>,
				     <0x00 4123 0x04>,
				     <0x00 4124 0x04>;
			clocks = <&scmi_clk 246>, <&dummy_clk_tmu>;
			clock-names = "fck", "dummy_clk_tmu";
			resets = <&scmi_reset 246>;
			status = "disabled";
		};

		tmu3: timer@c06a0000 {
			compatible = "renesas,tmu";
			reg = <0 0xc06a0000 0 0x30>;
			interrupts = <0x00 4125 0x04>,
				     <0x00 4126 0x04>,
				     <0x00 4127 0x04>,
				     <0x00 4128 0x04>;
			clocks = <&scmi_clk 247>, <&dummy_clk_tmu>;
			clock-names = "fck", "dummy_clk_tmu";
			resets = <&scmi_reset 247>;
			status = "disabled";
		};

		tmu4: timer@c06b0000 {
			compatible = "renesas,tmu";
			reg = <0 0xc06b0000 0 0x30>;
			interrupts = <0x00 4129 0x04>,
				     <0x00 4130 0x04>,
				     <0x00 4131 0x04>,
				     <0x00 4132 0x04>;
			clocks = <&scmi_clk 248>, <&dummy_clk_tmu>;
			clock-names = "fck", "dummy_clk_tmu";
			resets = <&scmi_reset 248>;
			status = "disabled";
		};

		i2c0: i2c@c11d0000 {
			compatible = "renesas,i2c-r8a78000","renesas,rcar-gen5-i2c";
			reg = <0 0xc11d0000 0 0x40>;
			// interrupts = <0x00 4807 0x04>;
			interrupts = <0x00 44 0x04>;
			i2c-scl-internal-delay-ns = <110>;
			clocks = <&scmi_clk 0x30c>;
			dmas = <&scp_dmac0 0x31>, <&scp_dmac0 0x30>,
			       <&scp_dmac1 0x31>, <&scp_dmac1 0x30>;
			dma-names = "tx", "rx", "tx", "rx";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			pinctrl-0 = <&i2c0_pins>;
			pinctrl-names = "default";

			clock-frequency = <100000>;

		};

		i2c1: i2c@c06c0000 {
			compatible = "renesas,i2c-r8a78000\0renesas,rcar-gen5-i2c";
			reg = <0x00 0xc06c0000 0x00 0x40>;
			interrupts = <0x00 0x3bc 0x04>;
			i2c-scl-internal-delay-ns = <0x6e>;
			clocks = <&scmi_clk 0xd1>;
			dmas = <&sys_dmac10 0x93>, <&sys_dmac10 0x92>,
			       <&sys_dmac11 0x93>, <&sys_dmac11 0x92>,
			       <&sys_dmac12 0x93>, <&sys_dmac12 0x92>;
			dma-names = "tx\0rx\0tx\0rx\0tx\0rx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-0 = <&i2c1_pins>;
			pinctrl-names = "default";
			clock-frequency = <0x61a80>;

		};

		i2c2: i2c@c06c8000 {
			compatible = "renesas,i2c-r8a78000","renesas,rcar-gen5-i2c";
			reg = <0 0xc06c8000 0 0x40>;
			interrupts = <0x00 957 0x04>;
			i2c-scl-internal-delay-ns = <110>;
			clocks = <&scmi_clk 0xd2>;
