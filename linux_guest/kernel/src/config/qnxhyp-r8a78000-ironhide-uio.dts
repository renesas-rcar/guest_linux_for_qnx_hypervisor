			};

			port@3 {
				reg = <3>;
				max96726_in11: endpoint {
				};
			};

			port@4 {
				reg = <4>;
				max96726_out2: endpoint {
					bus-type = <2>;
					clock-lanes = <0>;
					data-lanes = <1 2 3 4>;
					// remote-endpoint = <&csi42_in>;
				};
			};
		};

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			i2c@0 {
