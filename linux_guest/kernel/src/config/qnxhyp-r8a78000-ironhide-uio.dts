	ufs0_clk: ufs0-clk {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x249f000>;
	};

	ufs1_clk: ufs1-clk {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x249f000>;
	};

	aliases {
		i2c0 = "/soc/i2c@c11d0000";
		i2c1 = "/soc/i2c@c06c0000";
		i2c2 = "/soc/i2c@c06c8000";
		i2c3 = "/soc/i2c@c06d0000";
		i2c4 = "/soc/i2c@c06d8000";
		i2c5 = "/soc/i2c@c06e0000";
		i2c6 = "/soc/i2c@c06e8000";
		i2c7 = "/soc/i2c@c06f0000";
		i2c8 = "/soc/i2c@c06f8000";
	};

	chosen {
		stdout-path = "serial0:1843200n8";
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ipl0: ipl0@40000000 {
			no-map;
			reg = <0x0 0x40000000 0x0 0x2b800000>;
		};

		frtos_app: frtos_app@6b800000 {
			no-map;
			reg = <0x0 0x6b800000 0x0 0x1f800000>;
		};

		ipl1: ipl1@8b000000 {
			no-map;
			reg = <0x0 0x8b000000 0x0 0x3200000>;
		};

		ldr: ldr@8e200000 {
			no-map;
			reg = <0x0 0x8e200000 0x0 0x100000>;
		};

		cr52_ram0: cr52_ram0@96600000 {
			no-map;
			reg = <0x0 0x96600000 0x0 0x50000>;
		};

		cr52_ram1: cr52_ram1@96650000 {
			no-map;
			reg = <0x0 0x96650000 0x0 0x50000>;
		};

		cr52_ram2: cr52_ram2@966a0000 {
			no-map;
			reg = <0x0 0x966a0000 0x0 0x50000>;
		};

		cr52_ca720_share: cr52_ca720_share@966f0000 {
			no-map;
			reg = <0x0 0x966f0000 0x0 0x7f10000>;
		};

		linux,cma@a2600000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x00 0xa2600000 0x00 0x1da00000>;
			linux,cma-default;
		};

		// linux,cma@1c00000000 {
		// 	compatible = "shared-dma-pool";
		// 	reusable;
		// 	reg = <0x1c 0x0 0x0 0x40000000>;
		// };

		ecc_data_region@10cccc0000 {
			no-map;
			reg = <0x10 0xcccd0000 0x0 0x33330000>;
		};

		rt_vram: rt_vram@1200000000 {
			no-map;
			reg = <0x12 0x00000000 0x0 0x18000000>;
		};

		ecc_data_region@12cccc0000 {
			no-map;
			reg = <0x12 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@14cccc0000 {
			no-map;
			reg = <0x14 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@16cccc0000 {
			no-map;
			reg = <0x16 0xcccd0000 0x0 0x33330000>;
		};

		gsx_lma_heap@1800000000 {
			no-map;
			reg = <0x18 0x00000000 0x0 0xcccd0000>;
		};

		ecc_data_region@18cccc0000 {
			no-map;
			reg = <0x18 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@1acccc0000 {
			no-map;
			reg = <0x1a 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@1ccccc0000 {
			no-map;
			reg = <0x1c 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@1ecccc0000 {
			no-map;
			reg = <0x1e 0xcccd0000 0x0 0x33330000>;
		};
	};
};
&rwdt {
	status = "disabled"; //QNX Host is using
};
&rtt_dmac0 {
	status = "disabled"; //QNX Host is using
};
&rtt_dmac1 {
	status = "disabled"; //QNX Host is using
};
&i2c0 {
	eeprom@50 {
		compatible = "rohm,br24g01", "atmel,24c01";
		reg = <0x50>;
		pagesize = <8>;
	};
};
&i2c3 {
	gmsl0: gmsl-deserializer@31 {
		compatible = "maxim,max96726";
		reg = <0x31>, <0x01>, <0x02>, <0x03>, <0x04>;
		gpios = <&io_expander_u297 0 0>;
		gpio-controller;
		#gpio-cells = <2>;
		power-supply = <&max20087_0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				max96726_in0: endpoint {
				};
			};

			port@1 {
				reg = <1>;
				max96726_in1: endpoint {
				};
			};

			port@2 {
				reg = <2>;
				max96726_in2: endpoint {
				};
			};

			port@3 {
				reg = <3>;
				max96726_in3: endpoint {
				};
			};

			port@4 {
				reg = <4>;
				max96726_out0: endpoint {
					bus-type = <2>;
					clock-lanes = <0>;
					data-lanes = <1 2 3 4>;
					// remote-endpoint = <&csi40_in>;
				};
			};
		};

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			i2c@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				status = "disabled";
			};

			i2c@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;

				status = "disabled";
			};

			i2c@2 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <2>;

				status = "disabled";
			};

			i2c@3 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <3>;

				status = "disabled";
			};
		};
	};

	gmsl1: gmsl-deserializer@33 {
		compatible = "maxim,max96726";
		reg = <0x33>, <0x05>, <0x06>, <0x07>, <0x08>;
		gpios = <&io_expander_u297 0 0>;
		gpio-controller;
		#gpio-cells = <2>;
		power-supply = <&max20087_1>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				max96726_in4: endpoint {
				};
			};

			port@1 {
				reg = <1>;
				max96726_in5: endpoint {
				};
			};

			port@2 {
				reg = <2>;
				max96726_in6: endpoint {
				};
			};

			port@3 {
				reg = <3>;
				max96726_in7: endpoint {
				};
			};

			port@4 {
				reg = <4>;
				max96726_out1: endpoint {
					bus-type = <2>;
					clock-lanes = <0>;
					data-lanes = <1 2 3 4>;
					// remote-endpoint = <&csi41_in>;
				};
			};
		};

		i2c-mux {
			#address-cells = <1>;
			#size-cells = <0>;

			i2c@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				status = "disabled";
			};

			i2c@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;

				status = "disabled";
			};

			i2c@2 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <2>;

				status = "disabled";
			};

			i2c@3 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <3>;

				status = "disabled";
			};
		};
	};
};
&i2c4 {
	gmsl2: gmsl-deserializer@31 {
		compatible = "maxim,max96726";
		reg = <0x31>, <0x01>, <0x02>, <0x03>, <0x04>;
		gpios = <&io_expander_u299 0 0>;
		gpio-controller;
		#gpio-cells = <2>;
		power-supply = <&max20087_2>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				max96726_in8: endpoint {
				};
			};

			port@1 {
				reg = <1>;
				max96726_in9: endpoint {
				};
			};

			port@2 {
				reg = <2>;
				max96726_in10: endpoint {
