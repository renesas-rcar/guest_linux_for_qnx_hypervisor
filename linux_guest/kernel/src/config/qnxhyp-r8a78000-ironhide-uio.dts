		rpc: spi@c08c0000 {
			compatible = "renesas,rcar-gen5-rpc-if";
			reg =	<0 0xc08c0000 0 0x200>,
				<0 0x34000000 0 0x04000000>,
				<0 0xc08c8000 0 0x100>;
			reg-names = "regs", "dirmap", "wbuf";
			interrupts = <0x00 895 0x04>;
			clocks = <&scmi_clk 197>;
			resets = <&scmi_reset 197>;
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-0 = <&rpc_pins>;
			pinctrl-names = "default";

			status = "disabled";

			flash@0 {
				compatible = "cypress,hyperflash", "cfi-flash";
				reg = <0>;
				spi-max-frequency = <160000000>;
				spi-rx-bus-width = <4>;
				spi-tx-bus-width = <1>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <1>;
					#size-cells = <1>;

					boot@0 {
						reg = <0x0 0x1200000>;
						read-only;
					};

					user@2780000 {
						reg = <0x2780000 0x01880000>;
					};
				};
			};
		};

